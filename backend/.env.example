# Copy to .env (gitignored by the repo root .gitignore's bare ".env" rule)
# and fill in your real key. Never commit the real .env file.

ANTHROPIC_API_KEY=
# Optional -- defaults to claude-sonnet-5 if unset.
ANTHROPIC_MODEL=claude-sonnet-5

# From https://elevenlabs.io/app (API key) and
# https://elevenlabs.io/app/voice-library (pick a voice, copy its ID).
ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_VOICE_ID=

# Signs/verifies short-lived session JWTs issued by POST /v1/auth/session --
# server-only, never sent to or read by the client. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Still not real per-user auth -- see requireAuth's comment in server.js.
SESSION_JWT_SECRET=
# How long a minted session token stays valid, in seconds. Optional,
# defaults to 900 (15 minutes) if unset -- shorter shrinks the window a
# leaked token is useful in, at the cost of more frequent /v1/auth/session
# calls from the client.
SESSION_TOKEN_TTL_SECONDS=900

PORT=3000
# Requests per window, per IP -- see server.js's own comment on why this
# exists (requireAuth proves the caller holds a valid session token, not
# who they are). Optional, defaults shown.
CHAT_RATE_LIMIT=30
TTS_RATE_LIMIT=15
STT_RATE_LIMIT=15
# Ceiling on how often a single IP can mint a new session token -- see
# sessionLimiter's comment in server.js.
SESSION_RATE_LIMIT=20

# Your own long-lived, unlimited, unrate-limited token -- optional (the
# server runs fine without it; developer-only access is simply disabled
# if unset). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# NEVER put this in the mobile app, src/, the repo root .env, or anywhere
# else that ends up in a client build -- see its own comment in server.js
# for exactly how it's checked and how to send it (a plain
# `Authorization: Bearer <this value>` header directly on
# /v1/chat/messages, /v1/tts/synthesize, or /v1/stt/transcribe -- no need
# to call /v1/auth/session first).
DEVELOPER_TOKEN=
