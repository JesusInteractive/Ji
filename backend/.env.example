# Copy to .env (gitignored by the repo root .gitignore's bare ".env" rule)
# and fill in your real key. Never commit the real .env file.

ANTHROPIC_API_KEY=
# Optional -- defaults to claude-sonnet-5 if unset.
ANTHROPIC_MODEL=claude-sonnet-5

# From https://elevenlabs.io/app (API key) and
# https://elevenlabs.io/app/voice-library (pick a voice, copy its ID).
ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_VOICE_ID=

# Shared secret between this backend and the app (EXPO_PUBLIC_BACKEND_SECRET
# in the repo root .env) -- generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Not real per-user auth -- see requireAuth's comment in server.js.
BACKEND_SECRET=

PORT=3000
# Requests per window, per IP -- see server.js's own comment on why this
# exists (requireAuth proves the caller knows the shared secret, not who
# they are). Optional, defaults shown.
CHAT_RATE_LIMIT=30
TTS_RATE_LIMIT=15
